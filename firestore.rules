rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Get the user's Firestore document data (single get, reused)
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper to check if the logged in user is an Admin
    // Uses a single get() call (null-safe) instead of exists() + get()
    function isAdmin() {
      return isAuthenticated() && getUserData().get('isAdmin', false) == true;
    }
    
    // Helper to check if the logged in user is a Moderator (or Admin)
    function isModerator() {
      return isAuthenticated() && (
        getUserData().get('isModerator', false) == true ||
        getUserData().get('isAdmin', false) == true
      );
    }

    // Rules for users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Rules for weekly_goals collection
    match /weekly_goals/{goalId} {
      allow read: if isAuthenticated();
      // Allow write if the goalId contains their userId or they are owner (e.g. userUid_weekId)
      allow write: if isAuthenticated() && (goalId.matches('^' + request.auth.uid + '_.*') || isAdmin() || isModerator());
    }

    // Rules for week_settings collection
    match /week_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Rules for attendance_sessions collection
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isModerator();
    }

    // Rules for attendance_records collection
    match /attendance_records/{recordId} {
      allow read: if isAuthenticated();
      // Allow write if they are creating their own record or are admin
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Rules for announcements collection
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isModerator();
    }

    // Rules for system_data collection
    match /system_data/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Rules for monthly_visions collection
    match /monthly_visions/{visionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (visionId.matches('^' + request.auth.uid + '_.*') || isAdmin());
    }

    // Rules for daily_streaks collection
    match /daily_streaks/{streakId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(streakId) || isAdmin();
    }

    // Rules for weekly_pairings collection
    match /weekly_pairings/{pairingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isModerator();
    }
  }
}
